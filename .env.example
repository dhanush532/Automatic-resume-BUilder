# Core application
APP_ENV=development
APP_NAME=CareerPilot
FRONTEND_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database — required to run migrations or persistent API features
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5432/careerpilot

# Authentication — generate a unique value before deploying
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=careerpilot_session
SESSION_COOKIE_SECURE=false
SESSION_DURATION_HOURS=168
SESSION_ACTIVITY_UPDATE_MINUTES=5
AUTH_LOGIN_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Email delivery — configure a provider before enabling verification/reset mail
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_PROVIDER_CONFIG=
EMAIL_API_KEY=
EMAIL_FAILOVER_PROVIDER=
EMAIL_MAX_ATTEMPTS=4
EMAIL_PROVIDER_PER_MINUTE=60
EMAIL_PROVIDER_PER_SECOND=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls

# OAuth — leave blank until the corresponding developer applications are configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
BACKEND_ORIGIN=http://localhost:8000
RECENT_AUTH_MINUTES=10

# AI — server-side only; never prefix this with NEXT_PUBLIC_
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Mock interviews — Gemini Developer API, backend only. Leave key blank to disable.
# Obtain your own key in Google AI Studio; eligible free-tier quotas vary by model/region.
GEMINI_API_KEY=
GEMINI_INTERVIEW_MODEL=gemini-3.8-flash

# Storage — configure an approved object-storage provider before accepting uploads
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Background queue — placeholder interface is available; configure a broker before workers are enabled
QUEUE_PROVIDER=
REDIS_URL=redis://localhost:6379/0

# Authorised job data providers
# Set to arbeitnow to enable the documented free API; blank disables network ingestion.
JOB_SOURCE_CONFIG=
JOB_FRESHNESS_HOURS=72

# Public, non-secret browser API base URL for local development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Vercel frontend ONLY: set NEXT_PUBLIC_API_BASE_URL=/api/v1 and this server-side
# HTTPS origin to the separate public API deployment; leave blank locally.
API_PROXY_ORIGIN=
